# HealthBot LLM Configuration
# Copy this file to .env and configure your preferred LLM provider

# LLM Provider: "ollama" (default), "openai", or "google"
LLM_PROVIDER=ollama

# Ollama Settings (if LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI Settings (if LLM_PROVIDER=openai)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Google Gemini Settings (if LLM_PROVIDER=google)
# Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-pro
